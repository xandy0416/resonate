{
  "name": "resonate",
  "version": "0.1.0",
  "private": true,
  "description": "聚合音乐：跨平台音乐检索、管理与播放（网易云真实接入，其余平台适配器预留）",
  "scripts": {
    "server": "npm --prefix server run start",
    "client": "npm --prefix client run dev",
    "dev": "concurrently -n server,client -c magenta,cyan \"npm:server\" \"npm:client\"",
    "install:all": "npm install --prefix server && npm install --prefix client",
    "build": "npm --prefix client run build"
  },
  "devDependencies": {
    "concurrently": "^9.1.0"
  }
}
